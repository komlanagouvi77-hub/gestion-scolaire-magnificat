# Exemple de configuration locale uniquement. Copiez ce fichier vers .env et remplacez les valeurs.
# En production, utilisez des variables d'environnement uniques et securisees.
DJANGO_SECRET_KEY=change-moi-en-local-cle-secrete-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de donnees PostgreSQL (laisser DB_NAME vide pour basculer automatiquement sur SQLite)
DB_NAME=gestion_scolaire
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_ici
DB_HOST=localhost
DB_PORT=5432

# Configuration optionnelle pour l'envoi d'emails (en developpement avec DEBUG=True, les emails s'affichent dans la console)
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=votre-adresse@gmail.com
# DJANGO_EMAIL_HOST_PASSWORD=votre-mot-de-passe-application

