# Configuration d'environnement - Complexe Scolaire Magnificat
DJANGO_SECRET_KEY=change-moi-en-production-cle-secrete
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=gestion-scolaire-magnificat-vcov.onrender.com,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://gestion-scolaire-magnificat-vcov.onrender.com

# Base de donnees PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Configuration Email (Gmail SMTP ou autre)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=direction@magnificat-scolaire.tg
EMAIL_HOST_PASSWORD=mot_de_passe_application
DEFAULT_FROM_EMAIL=Complexe Scolaire Magnificat <direction@magnificat-scolaire.tg>

# URL de la plateforme
PLATFORM_URL=https://gestion-scolaire-magnificat-vcov.onrender.com/app/

# ==============================================================================
# PASSERELLES PAIEMENT MOBILE MONEY (TOGO : T-MONEY & FLOOZ)
# ==============================================================================
# Option 1 : PayGate Global Togo (Reference N°1 Nationale a Lome - paygateglobal.com)
PAYGATE_AUTH_TOKEN=

# Option 2 : FedaPay UEMOA (fedapay.com)
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_ENVIRONMENT=live
