# Exemple de configuration locale uniquement. Copiez ce fichier vers .env et remplacez les valeurs.
# En production, utilisez des variables d'environnement uniques et securisees.
DJANGO_SECRET_KEY=change-moi-en-local-cle-secrete-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de donnees PostgreSQL (laisser DB_NAME vide pour basculer automatiquement sur SQLite)
DB_NAME=gestion_scolaire
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_ici
DB_HOST=localhost
DB_PORT=5432

# Configuration pour l'envoi d'emails réels via Gmail SMTP :
# 1. Activez la validation en 2 étapes sur votre compte Google.
# 2. Allez sur https://myaccount.google.com/apppasswords et créez un "Mot de passe d'application".
# 3. Renseignez l'adresse Gmail et les 16 lettres générées ci-dessous :
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=mon-ecole@gmail.com
# EMAIL_HOST_PASSWORD=abcdefghijklmnop
# DEFAULT_FROM_EMAIL=Complexe Scolaire Magnificat <mon-ecole@gmail.com>

